<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/webFilm"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shown until the operator enters the code of the person they're filming -->
    <LinearLayout
        android:id="@+id/joinOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FILM LIVE"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the code from the recording phone"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Populated at runtime with linked friends who are currently recording live -->
        <LinearLayout
            android:id="@+id/liveFriendsContainer"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp" />

        <View
            android:id="@+id/liveFriendsDivider"
            android:layout_width="220dp"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etJoinCode"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:hint="e.g. K3F9X"
            android:inputType="textCapCharacters"
            android:gravity="center"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textColor="@color/accent2"
            android:textColorHint="@color/muted"
            android:background="@color/surface"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnJoin"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:text="JOIN"
            android:textColor="@color/bg"
            android:background="@color/accent"
            app:backgroundTint="@color/accent" />

        <TextView
            android:id="@+id/tvJoinStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</FrameLayout>
