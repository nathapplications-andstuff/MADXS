<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/madxs_logo"
            android:contentDescription="@string/app_full_name"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_full_name"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="sign in to record, or try as guest"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:hint="email"
            android:inputType="textEmailAddress"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:background="@color/surface"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:hint="password"
            android:inputType="textPassword"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:background="@color/surface"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSignIn"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:text="SIGN IN"
            android:textColor="@color/bg"
            android:background="@color/accent"
            app:backgroundTint="@color/accent"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:text="CREATE ACCOUNT"
            android:textColor="@color/accent"
            android:background="@color/surface"
            app:backgroundTint="@color/surface"
            android:layout_marginBottom="16dp" />

        <View android:layout_width="260dp" android:layout_height="1dp"
            android:background="@color/border" android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:text="Continue with Google"
            android:textColor="@color/accent"
            android:background="@color/surface"
            app:backgroundTint="@color/surface"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnGuest"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:text="Try as guest"
            android:textColor="@color/accent"
            android:background="@color/surface"
            app:backgroundTint="@color/surface" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:textColor="@color/stop_red"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
